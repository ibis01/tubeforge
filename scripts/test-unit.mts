  eq(plan?.scenes.map((s) => s.kind), ["video", "3d"], "the 3d clip keeps its kind (the Part 0.3 gap closes)");
  eq(plan?.totalSec, 7, "the window math is untouched");
  eq(plan?.scenes[1].transitionIn, "fade", "the boundary transition rides");
  // THE WALL HOLDS: "3d" has NO compositor segment builder — the registry
  // does not grow; the kind is admitted only WITH its engine segment.
  eq([...COMPOSITOR_SEGMENT_KINDS], ["video", "image"], "the builder registry is unchanged (engine kinds admit via segments, the S143 law)");
  eq(validatePlanKinds(["video", "3d"]), { ok: false, unsupported: ["3d"] }, "the routing wall refuses a 3d plan without segments");
  eq(engineSegmentVerdict(["video", "3d"], [null, null]), { ok: false, missing: [{ position: 1, kind: "3d" }] }, "the verdict names the missing 3d segment (fail-closed)");
  eq(engineSegmentVerdict(["video", "3d"], [null, "/tmp/engine-segs/3d-scene-2/scene-3d.mp4"]), { ok: true, missing: [] }, "a 3d scene WITH its pre-rendered segment is admitted");
  eq(engineSegmentVerdict(["3d"], ["/x"]), { ok: true, missing: [] }, "a single 3d scene rides the same law");
  // The dispatcher wiring (the S157 usage-scan pattern — the compile reads
  // the source so the wiring cannot silently rot).
  const vj = fs.readFileSync("src/lib/tubeforge/video-jobs.ts", "utf8");
  ok(vj.includes('s.kind === "3d"'), "the mixed-engine dispatcher gate admits the 3d kind");
  ok(vj.includes('kindAt(i) === "3d"'), "the dispatcher builds 3d scenes through the 3D lane");
  ok(vj.includes("renderScene3D(doc,"), "the 3D engine render rides the dispatcher");
  ok(vj.includes("scene3d: video.scene3d"), "the video's scene3d doc rides into the dispatcher");
  ok(vj.includes("the video has no 3D scene doc"), "a 3d plan without the doc refuses loudly (fail-closed)");
  // The renderer consumes the finisher path (the pose channels are live).
  const r3 = fs.readFileSync("src/lib/tubeforge/render3d.ts", "utf8");
  ok(r3.includes("cameraPoseAt(doc, t)"), "the render loop evaluates the S167 camera pose path");
  ok(r3.includes("rollDeg"), "the page carries the roll channel (the shake's view-axis rotation)");
});

// ---------------------------------------------------------------------------
// S168 — the Director's closed authority vocabulary. The law: the Director
// NAMES supported commands, never INVENTS them. The catalogs DERIVE from
// the engines' own constants (membership is enforced here; ranges stay
// the engines' sanitizers' job — one writer each).
// ---------------------------------------------------------------------------
{
  const dv = await import("../src/lib/tubeforge/director-vocabulary");

  await test("s168: the decision domains are the closed nine from the roadmap ask", () => {
    eq([...dv.DIRECTOR_DECISION_DOMAINS], [
      "script", "storyboard", "scene-duration", "visual-style", "camera",
      "animation", "music", "sound", "production-mode",
    ], "the domain set is closed and matches the spec");
  });

  await test("s168: the animation catalog DERIVES from the engines' own constants", async () => {
    // Derivation, not duplication: the transition list IS the engine's
    // set (same module-level reference), the enters ARE the union of the
    // doc validator's own compatibility table, the eases ARE the ONE
    // curve table's keys.
    const tr = await import("../src/lib/tubeforge/graphics/transitions");
    ok(dv.DIRECTOR_TRANSITIONS === tr.NATIVE_TRANSITION_TYPES, "transitions derive from graphics/transitions (same reference, not a copy)");
    ok(dv.DIRECTOR_GRAPHICS_ENTERS.length >= 8 && dv.DIRECTOR_GRAPHICS_ENTERS.includes("count") && dv.DIRECTOR_GRAPHICS_ENTERS.includes("draw"),
      "the enter vocabulary covers the measured grammar");
    ok(dv.DIRECTOR_EASES.includes("measured-out") && dv.DIRECTOR_EASES.includes("expo-out") && dv.DIRECTOR_EASES.includes("parabolic-in-out"),
      "the ease vocabulary rides the S162-anchored curve table");
    eq(dv.DIRECTOR_CAMERA_MOVES.length, 14, "the classic camera list carries the whole MoveKind union");
    ok(dv.DIRECTOR_CAMERA_MOVES.includes("shake") && dv.DIRECTOR_CAMERA_MOVES.includes("hold"), "the finisher-era moves ride the catalog");
    eq(dv.DIRECTOR_SLIDE_CAMERAS.length, 4, "the slide camera set is the closed four");
    eq([...dv.DIRECTOR_3D_ACTIONS], ["object-add", "light-add", "camera-keyframe", "push-in", "shake"], "the 3D actions match the scene3d grammar");
    eq([...dv.DIRECTOR_WHITEBOARD_KNOBS], ["roughness", "bowing"], "the whiteboard knobs are the S164 pair");
    eq([...dv.DIRECTOR_GESTURE_INTENTS], ["setup", "action", "emphasis", "rest"], "the gesture intents are purposes, not poses");
    const expected = dv.DIRECTOR_GRAPHICS_ENTERS.length + dv.DIRECTOR_TRANSITIONS.length +
      dv.DIRECTOR_CAMERA_MOVES.length + dv.DIRECTOR_SLIDE_CAMERAS.length + 1 +
      dv.DIRECTOR_3D_ACTIONS.length + dv.DIRECTOR_WHITEBOARD_KNOBS.length + dv.DIRECTOR_GESTURE_INTENTS.length;
    eq(dv.DIRECTOR_ANIMATION_CATALOG.length, expected, "the catalog is exactly the union of its derived parts");
    for (const entry of dv.DIRECTOR_ANIMATION_CATALOG) {
      ok(typeof entry.implements === "string" && entry.implements.length > 8, `action ${entry.action} names its native implementor`);
    }
  });

  await test("s168: valid directives pass the validator", () => {
    eq(dv.validateDirectorDirective({ domain: "animation", target: "boundary:1", action: "transition:crossfade" }), { ok: true }, "a boundary transition passes");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "counter", action: "enter:count", params: { durationMs: 1200 } }), { ok: true }, "an element enter passes where the engine's table allows it");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "headline", action: "enter:fade" }), { ok: true }, "a legal per-kind enter passes");
    eq(dv.validateDirectorDirective({ domain: "camera", target: "scene-1", action: "camera:push-follow" }), { ok: true }, "a camera intent passes");
    eq(dv.validateDirectorDirective({ domain: "production-mode", target: "project", action: "mode:free" }), { ok: true }, "a production mode passes");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "character", action: "gesture:emphasis" }), { ok: true }, "a gesture intent passes");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "asset-1", action: "whiteboard:roughness", params: { value: 1.4 } }), { ok: true }, "a whiteboard knob passes");
  });

  await test("s168: invented commands are REJECTED, never coerced", () => {
    eq(dv.validateDirectorDirective({ domain: "animation", target: "x", action: "enter:explode-into-confetti" }).ok, false, "an invented enter is refused");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "x", action: "morphIntoDragon" }).ok, false, "a bare invented action is refused");
    eq(dv.validateDirectorDirective({ domain: "unknown-domain" as never, target: "x", action: "anything" }).ok, false, "an unknown domain is refused");
    eq(dv.validateDirectorDirective({ domain: "camera", target: "x", action: "camera:dolly-circles" }).ok, false, "a camera move outside the MoveKind union is refused");
    eq(dv.validateDirectorDirective({ domain: "music", target: "x", action: "music:generate-hit-single" }).ok, false, "music stays a suggestion namespace");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "unicorn-element", action: "enter:fade" }).ok, false, "an enter on a non-element target is refused");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "headline", action: "enter:count" }).ok, false, "the engine's own per-kind table refuses an illegal enter (count on a headline)");
    eq(dv.validateDirectorDirective({ domain: "animation", target: "counter", action: "transition:crossfade" }).ok, false, "a transition on a non-boundary target is refused");
  });

  await test("s168: the per-target and per-param walls hold", () => {
    const smuggle = dv.validateDirectorDirective({ domain: "animation", target: "character", action: "gesture:setup", params: { rotationZ: 42 } });
    eq(smuggle.ok, false, "a gesture param smuggling pose geometry is refused");
    const nan = dv.validateDirectorDirective({ domain: "animation", target: "counter", action: "enter:count", params: { durationMs: Number.NaN } });
    eq(nan.ok, false, "a NaN param is refused");
  });

  await test("s168: the batch gate is fail-closed and names the rejections", () => {
    const batch = [
      { domain: "animation", target: "boundary:1", action: "transition:iris" },
      { domain: "animation", target: "x", action: "enter:but-first-dance" },
      { domain: "camera", target: "scene-2", action: "camera:hold" },
    ];
    const res = dv.assertNoInventedCommands(batch as never[]);
    eq(res.ok, false, "a batch with an invented command fails");
    eq([...res.rejections.keys()], [1], "the rejection names exactly the offending index");
  });

  await test("s168: serialization is JSON-stable (sorted keys, round-trip equal)", () => {
    const dir = { domain: "animation", target: "counter", action: "enter:count", params: { z: 1, a: 2 } };
    const s1 = dv.serializeDirectorDirective(dir);
    const s2 = dv.serializeDirectorDirective(JSON.parse(s1) as typeof dir);
    eq(s1, s2, "the directive round-trips byte-stably");
    ok(s1.indexOf('"a"') < s1.indexOf('"z"'), "the params serialize key-sorted");
  });

  await test("s168: the prohibitions ride as data (the never-list)", () => {
    ok(dv.DIRECTOR_PROHIBITIONS.length >= 7, "the never-list is on record");
    ok(dv.DIRECTOR_PROHIBITIONS.some((p) => p.startsWith("no invented animation commands")), "the headline law is first among them");
    ok(dv.DIRECTOR_PROHIBITIONS.some((p) => p.includes("the engines render deterministically without AI")), "the AI-independence law rides");
  });
}

// ---------------------------------------------------------------------------
// S169 — the Universal Scene Schema. The Director-authored envelope over
// the six modes: strict validation (machine-authored data, junk is an
// error), provenance closure (no undeclared references), the S168
// directive gate, and the ONE mapping onto the S87 timeline.
// ---------------------------------------------------------------------------
{
  const us = await import("../src/lib/tubeforge/universal-scene");

  const goodScene = () => ({
    version: 1,
    sceneId: "scene_001",
    kind: "graphics",
    durationMs: 8000,
    background: { type: "image", assetId: "asset_001" },
    narration: { text: "The universe contains billions of galaxies.", voiceId: "narrator_01" },
    assets: [{ id: "asset_001", kind: "image", origin: "generated" }],
    directives: [
      { domain: "animation", target: "headline", action: "enter:rise" },
      { domain: "animation", target: "boundary:1", action: "transition:crossfade" },
    ],
  });

  await test("s169: the six modes are the closed kind set", () => {
    eq([...us.UNIVERSAL_SCENE_KINDS], ["graphics", "whiteboard", "slides", "classic", "character", "3d"], "the six production modes");
    eq([...us.UNIVERSAL_ASSET_ORIGINS], ["native", "stock", "generated", "upload", "reuse"], "the provenance origins");
    eq([...us.UNIVERSAL_PRODUCTION_MODES], ["free", "standard", "premium"], "the S184 operating modes ride the schema");
  });

  await test("s169: a valid scene passes strict validation", () => {
    const verdict = us.validateUniversalScene(goodScene());
    ok(verdict.ok, JSON.stringify(verdict.ok ? [] : verdict.errors));
  });

  await test("s169: the provenance closure refuses undeclared references", () => {
    const bad = { ...goodScene(), background: { type: "image", assetId: "asset_ghost" } };
    const v = us.validateUniversalScene(bad);
    eq(v.ok, false, "a background pointing outside assets[] is refused");
    ok(!v.ok && v.errors.some((e) => e.code === "provenance-closure"), "the closure error names the code");
    const dup = { ...goodScene(), assets: [{ id: "a", kind: "image", origin: "stock" }, { id: "a", kind: "audio", origin: "stock" }] };
    const v2 = us.validateUniversalScene(dup);
    ok(!v2.ok && v2.errors.some((e) => e.message.includes("duplicate asset id")), "duplicate asset ids are refused");
  });

  await test("s169: the clock walls and the closed sets hold", () => {
    for (const bad of [0, 200, Number.NaN, 2_000_000, 8000.5]) {
      ok(!us.validateUniversalScene({ ...goodScene(), durationMs: bad }).ok, `duration ${bad} is refused`);
    }
    ok(!us.validateUniversalScene({ ...goodScene(), kind: "hologram" }).ok, "a seventh mode is refused");
    ok(!us.validateUniversalScene({ ...goodScene(), background: { type: "color", color: "blue" } }).ok, "a junk color is refused");
    ok(!us.validateUniversalScene({ ...goodScene(), assets: [{ id: "a", kind: "image", origin: "stock", sha256: "deadbeef" }] }).ok, "a short sha256 is refused");
  });

  await test("s169: an invented directive invalidates the scene (the S168 gate rides)", () => {
    const v = us.validateUniversalScene({
      ...goodScene(),
      directives: [{ domain: "animation", target: "x", action: "enter:explode-into-confetti" }],
    });
    eq(v.ok, false, "the scene does not validate");
    ok(!v.ok && v.errors.some((e) => e.code === "directives" && e.message.includes("enter:explode-into-confetti")), "the error names the invented action");
  });

  await test("s169: the timeline projection maps the six modes onto the S87 track kinds", () => {
    const trackOf = (kind: string): string => {
      const scene = { ...goodScene(), kind } as never;
      const clip = us.projectUniversalScene(scene as never, 1, 0, 8);
      return clip.kind;
    };
    eq(trackOf("graphics"), "graphics", "graphics keeps its track kind");
    eq(trackOf("whiteboard"), "whiteboard", "whiteboard keeps its track kind");
    eq(trackOf("3d"), "3d", "3d keeps its track kind (the S167 admission)");
    eq(trackOf("character"), "character", "character keeps its track kind");
    eq(trackOf("slides"), "video", "slides render through the video lane");
    eq(trackOf("classic"), "video", "classic renders through the video lane");
  });

  await test("s169: the projection reads the inbound transition from the PREVIOUS scene's boundary", () => {
    const prev = { ...goodScene(), sceneId: "scene_001" } as never;
    const next = { ...goodScene(), sceneId: "scene_002", directives: [] } as never;
    // prev carries transition:crossfade on boundary:1 — the join 1→2 — so
    // scene 2's clip enters with it.
    const clip = us.projectUniversalScene(next as never, 2, 8, 16, prev as never);
    eq(clip.transitionIn, "crossfade", "the boundary directive becomes the clip's transitionIn");
    eq(clip.id, "s2", "the clip id follows the S2 doctrine");
    const first = us.projectUniversalScene(prev as never, 1, 0, 8);
    eq(first.transitionIn, null, "the first scene enters with no transition");
  });

  await test("s169: the project timeline sequences back-to-back, atSec wins when present", () => {
    const project = {
      version: 1,
      title: "The demo",
      mode: "free",
      scenes: [
        goodScene(),
        { ...goodScene(), sceneId: "scene_002", durationMs: 4000, atSec: 20 },
        { ...goodScene(), sceneId: "scene_003", durationMs: 4000 },
      ],
    } as never;
    const clips = us.projectUniversalTimeline(project as never);
    eq(clips.length, 3, "three clips project");
    eq(clips[1].startSec, 20, "the explicit atSec wins");
    eq(clips[2].startSec, 24, "the scene after the jump sequences from the cursor");
  });

  await test("s169: project validation enforces uniqueness and the closed mode set", () => {
    const dup = { version: 1, title: "T", mode: "free", scenes: [goodScene(), goodScene()] };
    const v = us.validateUniversalProject(dup);
    eq(v.ok, false, "duplicate sceneIds are refused");
    ok(!us.validateUniversalProject({ ...dup, mode: "enterprise", scenes: [{ ...goodScene(), sceneId: "scene_002" }] }).ok, "a bad mode is refused");
    ok(!us.validateUniversalProject({ ...dup, scenes: [] }).ok, "an empty project is refused");
    const good = { version: 1, title: "T", mode: "standard", scenes: [{ ...goodScene(), sceneId: "scene_002" }] };
    ok(us.validateUniversalProject(good).ok, "a clean project passes");
  });

  await test("s169: serialization is JSON-stable (sorted keys, round-trip equal)", () => {
    const scene = goodScene() as never;
    const s1 = us.serializeUniversalScene(scene);
    const s2 = us.serializeUniversalScene(JSON.parse(s1) as never);
    eq(s1, s2, "the scene round-trips byte-stably");
    ok(s1.indexOf('"action"') < s1.indexOf('"target"'), "keys serialize sorted");
  });
}

// ---------------------------------------------------------------------------
// S170 — the Animation Compiler. Translates Director instructions into
// native engine operations. THE acceptance: the AI provider disconnected
// after approval must not matter — the compile is data-in/data-out, the
// import graph carries zero provider modules (pinned by source scan).
// ---------------------------------------------------------------------------
{
  const ac = await import("../src/lib/tubeforge/animation-compiler");

  const threeModeProject = () => ({
    version: 1,
    title: "The offline compile",
    mode: "free",
    scenes: [
      {
        version: 1,
        sceneId: "scene_001",
        kind: "graphics",
        durationMs: 8000,
        narration: { text: "First the reach.", voiceId: "narrator_01" },
        assets: [],
        directives: [
          { domain: "animation", target: "counter", action: "enter:count", params: { durationMs: 1200, ease: "expo-out" } },
          { domain: "animation", target: "boundary:1", action: "transition:crossfade" },
          { domain: "music", target: "project", action: "music:suggest", params: { mood: "warm" } },
        ],
      },
      {
        version: 1,
        sceneId: "scene_002",
        kind: "character",
        durationMs: 6000,
        narration: { text: "Then the retention." },
        assets: [],
        directives: [
          { domain: "animation", target: "character", action: "gesture:emphasis" },
          { domain: "camera", target: "scene-2", action: "camera:hold" },
        ],
      },
      {
        version: 1,
        sceneId: "scene_003",
        kind: "3d",
        durationMs: 5000,
        assets: [],
        directives: [{ domain: "animation", target: "camera", action: "3d:push-in", params: { rate: 0.2 } }],
      },
    ],
  });

  await test("s170: the compiler walks the S169 project into typed engine operations", () => {
    const verdict = ac.compileUniversalProject(threeModeProject());
    ok(verdict.ok, JSON.stringify(verdict.ok ? [] : verdict.errors));
    if (!verdict.ok) return;
    const plan = verdict.plan;
    eq(plan.version, 1, "the compiler version rides");
    eq(plan.scenes.length, 3, "three scenes compile");
    eq(plan.totalMs, 19000, "the total clock is the projection's arithmetic (8+6+5 s)");
    const s1 = plan.scenes[0];
    const enterOp = s1.operations.find((o) => o.op === "graphics-enter");
    ok(enterOp !== undefined && enterOp.ease === "expo-out" && enterOp.durationMs === 1200, "the authored ease and duration are consumed from params");
    ok(enterOp !== undefined && enterOp.atMs === undefined, "an element enter leaves sequencing to the engine (no invented atMs)");
    const transOp = s1.operations.find((o) => o.op === "graphics-transition");
    eq(transOp?.atMs, 8000, "boundary:1 sits at scene 1's end — the schema's own clocks");
    const gestOp = plan.scenes[1].operations.find((o) => o.op === "gesture-intent");
    eq(gestOp?.atMs, 8000, "a scene-scoped gesture rides the scene's window");
    const camOp = plan.scenes[1].operations.find((o) => o.op === "camera-move");
    eq(camOp?.action, "camera:hold", "the camera intent compiles by catalog name");
    const d3 = plan.scenes[2].operations.find((o) => o.op === "3d-action");
    eq(d3?.atMs, 14000, "the 3d op rides the third window");
    eq(d3?.params.rate, 0.2, "unconsumed params ride verbatim");
    eq(plan.suggestions.length, 1, "the music suggestion is a suggestion, not an op");
    eq(plan.suggestions[0].action, "music:suggest", "the suggestion passes verbatim");
  });

  await test("s170: narration slots carry the scene windows", () => {
    const verdict = ac.compileUniversalProject(threeModeProject());
    ok(verdict.ok);
    if (!verdict.ok) return;
    const s1 = verdict.plan.scenes[0].narration;
    ok(s1 !== null && s1.text === "First the reach." && s1.atMs === 0 && s1.durationMs === 8000, "scene 1's narration slot rides its window");
    eq(verdict.plan.scenes[2].narration, null, "a scene without narration compiles to a null slot");
  });

  await test("s170: the ease wall and the boundary arithmetic are fail-closed", () => {
    const badEase = threeModeProject() as { scenes: { directives: unknown[] }[] };
    (badEase.scenes[0].directives as unknown[])[0] = { domain: "animation", target: "counter", action: "enter:count", params: { ease: "ease-springy-9000" } };
    const v = ac.compileUniversalProject(badEase);
    ok(!v.ok && v.errors.some((e) => e.message.includes("measured curve table")), "an ease outside the ONE table refuses");
    const ghost = threeModeProject() as { scenes: { directives: unknown[] }[] };
    (ghost.scenes[0].directives as unknown[])[2] = { domain: "animation", target: "boundary:5", action: "transition:iris" };
    const v2 = ac.compileUniversalProject(ghost);
    ok(!v2.ok && v2.errors.some((e) => e.message.includes("boundary:5")), "a boundary past the last scene refuses (defense in depth)");
  });

  await test("s170: THE acceptance — the import graph carries zero provider modules (the AI can be disconnected)", () => {
    const src = fs.readFileSync("src/lib/tubeforge/animation-compiler.ts", "utf8");
    const imports = [...src.matchAll(/from "\.\/([^"]+)"/g)].map((m) => m[1]);
    ok(imports.length >= 2, "the module declares its imports");
    for (const imp of imports) {
      ok(!/(zai|llm|provider|voice|openai|research|ai\.ts)/.test(imp), `import "./${imp}" is data-only — no AI/provider module`);
    }
    ok(imports.includes("director-vocabulary") && imports.includes("universal-scene"), "the compiler rides the S168 vocabulary and the S169 schema");
    ok(!src.includes("fetch(") && !src.includes("Date.now") && !src.includes("Math.random"), "no network, no wall-clock, no randomness in the compile path");
  });
}

// ---------------------------------------------------------------------------
// S171 — the shared animation vocabulary (mode-agnostic primitives over
// the ONE curve table) and S172 — the cross-mode capability matrix
// (borrow through the ONE implementor, honest wiring statuses).
// ---------------------------------------------------------------------------
{
  const prim = await import("../src/lib/tubeforge/anim/primitives");
  const cm = await import("../src/lib/tubeforge/cross-mode");

  await test("s171: the primitive set is the closed fourteen from the roadmap ask", () => {
    eq([...prim.PRIMITIVE_NAMES], [
      "fade", "scale", "rotate", "translate", "draw", "reveal", "morph",
      "camera-pan", "camera-zoom", "particle", "character-move", "stagger",
      "spring", "parallax",
    ], "the named fourteen, closed");
    for (const name of prim.PRIMITIVE_NAMES) {
      const wall = prim.PRIMITIVE_TIMING[name];
      ok(wall.minMs > 0 && wall.defaultMs >= wall.minMs && wall.maxMs >= wall.defaultMs, `${name} carries honest timing walls`);
    }
  });

  await test("s171: every primitive rides the ONE curve table (easing overrides must be table names)", () => {
    ok(prim.samplePrimitive("fade", 0.5).ok, "the default ease rides the table");
    ok(prim.samplePrimitive("fade", 0.5, { ease: "expo-out" as never }).ok, "a table-named override passes");
    const v = prim.samplePrimitive("fade", 0.5, { ease: "ease-springy-9000" as never });
    eq(v.ok, false, "an ease outside the table refuses");
    ok(!v.ok && v.errors.some((e) => e.code === "unknown-ease"), "the refusal names the code");
  });

  await test("s171: samples are normalized, clamped and pure", () => {
    const fade = prim.samplePrimitive("fade", 0.42);
    ok(fade.ok && (fade.state.opacity ?? -1) >= 0 && (fade.state.opacity ?? -1) <= 1, "fade opacity clamped");
    const zoom = prim.samplePrimitive("camera-zoom", 0.9, { to: 99 });
    ok(zoom.ok && (zoom.state.camera?.zoom ?? 0) <= 3, "camera zoom clamped to the physical ceiling");
    const clamped = prim.samplePrimitive("fade", 7); // t beyond 1
    ok(clamped.ok && (clamped.state.opacity ?? 0) <= 1, "t01 clamps before sampling");
    const junk = prim.samplePrimitive("fade", 0.5, { explode: true } as never);
    eq(junk.ok, false, "unknown params refuse (never coerce)");
    ok(!prim.samplePrimitive("explode-into-confetti" as never, 0.5).ok, "a sixteenth primitive does not exist");
    // Determinism: same inputs, same state.
    eq(prim.samplePrimitive("spring", 0.3, { damping: 0.4, frequency: 2 }).ok, prim.samplePrimitive("spring", 0.3, { damping: 0.4, frequency: 2 }).ok, "spring samples evaluate");
    const a = prim.samplePrimitive("spring", 0.3, { damping: 0.4, frequency: 2 });
    const b = prim.samplePrimitive("spring", 0.3, { damping: 0.4, frequency: 2 });
    eq(a.ok && b.ok ? a.state.scale : 0, b.ok && b.state.scale !== undefined ? b.state.scale : 0, "the spring is deterministic");
  });

  await test("s171: the timing walls refuse loose clocks", () => {
    eq(prim.checkPrimitiveTiming("fade", 50)?.code, "timing-wall", "below the wall refuses");
    eq(prim.checkPrimitiveTiming("fade", 5000)?.code, "timing-wall", "above the wall refuses");
    eq(prim.checkPrimitiveTiming("fade", 400), null, "the default rides inside the wall");
  });

  await test("s171: the stagger schedule is arithmetic, honest, bounded", () => {
    const schedule = prim.staggerSchedule(5, 1000);
    eq(schedule.length, 5, "one window per item");
    eq(schedule[0].itemMs, 0, "the first item starts at zero");
    ok(schedule[1].itemMs > schedule[0].itemMs, "delays increase");
    eq(prim.staggerSchedule(1, 400)[0].windowMs, 400, "a solo item takes the whole window");
    let threw = false;
    try { prim.staggerSchedule(0, 100); } catch { threw = true; }
    ok(threw, "an empty schedule throws");
  });

  await test("s172: the capability matrix is closed, honest and house-implemented", () => {
    const audit = cm.crossModeMatrixAudit();
    ok(audit.ok, JSON.stringify(audit.problems));
    ok(cm.CROSS_MODE_CAPABILITIES.length >= 9, "the matrix carries the roadmap's named capabilities plus the house's own");
    const wirings = cm.CROSS_MODE_CAPABILITIES.map((c) => c.wiring);
    ok(wirings.includes("native") && wirings.includes("borrowed") && wirings.includes("codified"), "all three honesty levels are in use — the matrix is not a wish list");
  });

  await test("s172: the resolver admits hosts and named borrowers, refuses the rest", () => {
    eq(cm.resolveCrossModeCapability("animated charts", "graphics").ok, true, "the host resolves");
    eq(cm.resolveCrossModeCapability("animated charts", "whiteboard").ok, true, "a named borrower resolves");
    eq(cm.resolveCrossModeCapability("animated charts", "character").ok, false, "an unnamed borrower refuses");
    ok(!cm.resolveCrossModeCapability("holodeck", "graphics").ok, "a capability outside the matrix refuses");
    const kinetic = cm.resolveCrossModeCapability("kinetic typography", "slides");
    ok(kinetic.ok && kinetic.implements !== undefined, "a resolution names the ONE implementor");
  });
}

// ---------------------------------------------------------------------------
// S173-S176 — Programme D (the voice engine): the Kokoro adoption rides
// the registry; the router enforces the tiered hierarchy and principle 8
// BY SIGNATURE; the manager plans chunks, profiles and selective
// regeneration — all pure.
// ---------------------------------------------------------------------------
{
  const vr = await import("../src/lib/tubeforge/voice-router");
  const vm = await import("../src/lib/tubeforge/voice-manager");
  const reg = await import("../src/lib/tubeforge/providers/registry");

  await test("s173: Kokoro is adopted in the registry (the lightweight local candidate)", () => {
    const kokoro = reg.TTS_PROVIDERS.find((p) => p.id === "kokoro");
    ok(kokoro !== undefined, "the kokoro provider entry exists");
    ok(kokoro?.requiresKey === false, "loopback local — no key needed");
    ok(kokoro?.models.some((m) => m.hint?.includes("Apache-2.0")), "the licence hint rides (principle 9: reviewed, commercial-OK)");
  });

  await test("s173: the local tier contract holds (zero-cost, registry-present)", () => {
    const contract = vr.localVoiceTierContract();
    ok(contract.ok, JSON.stringify(contract.problems));
    ok(vr.VOICE_TIERS.zero.includes("kokoro") && vr.VOICE_TIERS.zero.includes("selfhost"), "the tier-1 zero-cost set carries chatterbox + kokoro");
  });

  await test("s176: the router honors tier order and availability — never assumption", () => {
    const ack = vr.routeVoiceGeneration({ mode: "standard", availableProviderIds: ["openai", "selfhost", "heygen"], paidFallbackAcknowledged: true });
    ok(ack.ok, ack.ok ? "" : ack.reason);
    if (ack.ok) {
      const rankOf = { zero: 0, freetier: 1, paid: 2 } as const;
      eq(ack.plan.primary.providerId, "selfhost", "the zero-cost tier wins structurally");
      eq(ack.plan.primary.costClass, "zero", "the primary is zero-cost");
      ok(ack.plan.fallbacks.every((s) => rankOf[ack.plan.primary.costClass] <= rankOf[s.costClass]), "fallbacks never climb tiers downward");
    }
    const noAck = vr.routeVoiceGeneration({ mode: "standard", availableProviderIds: ["openai", "selfhost", "heygen"] });
    eq(noAck.ok, false, "the same chain WITHOUT the acknowledgement refuses — a paid fallback is a decision, never a default");
  });

  await test("s176: principle 8 BY SIGNATURE — a paid fallback needs the acknowledgement flag", () => {
    const refusal = vr.routeVoiceGeneration({ mode: "standard", availableProviderIds: ["elevenlabs"] });
    eq(refusal.ok, false, "a paid-only chain refuses without the flag");
    ok(!refusal.ok && refusal.reason.includes("paidFallbackAcknowledged"), "the refusal names the required flag");
    const okd = vr.routeVoiceGeneration({ mode: "standard", availableProviderIds: ["elevenlabs"], paidFallbackAcknowledged: true });
    ok(okd.ok, "the acknowledged chain runs");
  });

  await test("s176: the FREE mode routes to zero-cost ONLY — paid is a refusal, not a warning", () => {
    const refusal = vr.routeVoiceGeneration({ mode: "free", availableProviderIds: ["selfhost", "elevenlabs"] });
    ok(refusal.ok, "the free mode runs when a zero-cost provider exists");
    if (refusal.ok) {
      ok(refusal.plan.fallbacks.every((s) => s.costClass === "zero"), "no paid step rides the free chain");
    }
    const dead = vr.routeVoiceGeneration({ mode: "free", availableProviderIds: ["elevenlabs", "openai"] });
    eq(dead.ok, false, "a free mode with only paid providers refuses outright");
    ok(!dead.ok && dead.reason.includes("self-hosted zero-cost providers ONLY"), "the refusal states the law");
  });

  await test("s174: the quality profiles compile with Nigerian English first-class", () => {
    const v = vm.buildVoiceProfileDirective("nigerian-english");
    ok(v.ok && v.directive.rate === 0.95 && v.directive.emotion === "warm", "the profile's measured defaults ride");
    ok(!vm.buildVoiceProfileDirective("australian-english" as never).ok, "a sixth profile does not exist");
    ok(!vm.buildVoiceProfileDirective("british-english", { rate: 3 }).ok, "a rate outside [0.5, 1.5] refuses");
    const longForm = vm.buildVoiceProfileDirective("british-english", {}, { longForm: true });
    eq(longForm.ok, false, "a long-form production without a pinned voice refuses (the consistency law)");
    ok(vm.buildVoiceProfileDirective("british-english", { voiceId: "narrator_01" }, { longForm: true }).ok, "a pinned voice satisfies it");
  });

  await test("s175: the chunker is deterministic sentence-boundary splitting", () => {
    const text = "First sentence is short. Second sentence is much longer and carries several clauses, commas, and a final period. Third! Fourth asks a question?";
    const chunks = vm.chunkNarration(text);
    ok(chunks.length >= 1, `the narration splits into ${chunks.length} chunk(s)`);
    const rejoined = chunks.map((c) => c.text).join(" ");
    ok(rejoined.includes("First sentence is short.") && rejoined.includes("question?"), "every sentence survives the split");
    eq(vm.chunkNarration(""), [], "empty narration chunks to nothing");
    const long = Array.from({ length: 40 }, (_, i) => `Sentence number ${i} here carries about fifteen words of narration for the voice engine.`).join(" ");
    const longChunks = vm.chunkNarration(long);
    ok(longChunks.length >= 3, `a long script splits (${longChunks.length} chunks)`);
    ok(longChunks.every((c) => c.text.length <= vm.CHUNK_MAX_CHARS), "no chunk breaks the wall");
    // Determinism: same text, same chunks.
    eq(JSON.stringify(vm.chunkNarration(long)), JSON.stringify(vm.chunkNarration(long)), "the split is deterministic");
  });

  await test("s175: the planner maps chunks onto slots with corrections; regeneration is selective", () => {
    const slots = [
      { sceneId: "scene_001", text: "Lagos is home to the tech scene.", voiceId: "v1", providerHint: undefined, atMs: 0, durationMs: 3000 },
      { sceneId: "scene_002", text: "The Lagoserian market grows.", voiceId: "v1", providerHint: undefined, atMs: 3000, durationMs: 3000 },
    ] as never[];
    const res = vm.planVoiceProduction(slots as never, { profile: "nigerian-english", rate: 0.95, pauseScale: 1.1, emotion: "warm", voiceId: "v1" }, [{ from: "Lagos", to: "Lay-gos" }] as never);
    ok(res.ok, res.ok ? "" : res.errors.join("; "));
    if (!res.ok) return;
    eq(res.plan.chunks.length, 2, "two slots, two chunk plans");
    ok(res.plan.chunks.every((c) => c.corrections.some((k) => k.from === "Lagos")), "the pronunciation correction rides every chunk that mentions the word");
    const verdicts = [
      { chunkId: res.plan.chunks[0].chunk.chunkId, ok: true, durationMs: 1400 },
      { chunkId: res.plan.chunks[1].chunk.chunkId, ok: false, error: "provider 429" },
      { chunkId: "chunk-stale-999", ok: false, error: "stale receipt" },
    ];
    const regen = vm.chunksNeedingRegeneration(res.plan, verdicts);
    eq(regen.length, 2, "exactly the failed + stale chunks regenerate");
    ok(!regen.includes(res.plan.chunks[0].chunk.chunkId), "the SUCCESSFUL chunk is untouched — regeneration is selective, never whole-script");
  });
}

