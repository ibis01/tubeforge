await test("S49 qc battery: the restricted-visual check rides the report when the scan ran", async () => {
  const { runQcReport } = await import("../src/lib/tubeforge/qc.ts");
  const opts = {
    mp4Path: "/nonexistent/tf-s49/final.mp4",
    videoDuration: 10,
