suiteStart("graphics — S130 (PAE-2) the scene camera");

function gCamKey(tMs: number, zoom: number, tx: number, ty: number, ease?: string): Record<string, unknown> {
  return ease !== undefined ? { tMs, zoom, tx, ty, ease } : { tMs, zoom, tx, ty };
}

