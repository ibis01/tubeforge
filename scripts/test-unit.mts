    eq(crossVideoOverall([{ score: 95 }, { score: null }, { score: 88 }]), 88, "unavailable rows are ignored, never punished");
    eq(crossVideoOverall([{ score: null }, { score: null }]), 0, "nothing scored = honest zero, never a fabricated pass");
