# TubeForge environment template — copy to .env and fill in your own values.
# Your real .env is gitignored and will never be pushed.

# Database
# - Production / Vercel (default in prisma/schema.prisma):
#   DATABASE_URL=postgresql://user:password@host:5432/tubeforge
# - Local development with SQLite: switch the schema provider to "sqlite"
#   (see SETUP.md "Local development") and use:
DATABASE_URL=postgresql://user:password@host:5432/tubeforge

# Signs every session/API token (HMAC). Rotating it invalidates ALL issued
# tokens. Without it the production server refuses to serve any API (503).
# Generate your own:  openssl rand -hex 32
TUBEFORGE_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Stage 2 — encrypts secrets at rest (provider API keys, YouTube refresh
# tokens) with AES-256-GCM. Rotating it invalidates every STORED secret.
# Without it any credential save fails closed (visible error, no plaintext).
# Generate your own:  openssl rand -hex 32
TUBEFORGE_ENCRYPTION_KEY=replace-with-another-openssl-rand-hex-32

# Stage 3 (T-3.9) — email delivery mode for verification / password-reset links.
#   console (default) — links are logged + returned in the response (no SMTP;
#                       fine for single-owner installs and local dev)
#   smtp               — real delivery through the zero-dep SMTP client
#                       (STARTTLS on 25/587, implicit TLS on 465)
# TUBEFORGE_EMAIL_MODE=console
# TUBEFORGE_SMTP_HOST=smtp.example.com
# TUBEFORGE_SMTP_PORT=587
# TUBEFORGE_SMTP_USER=postmaster@example.com
# TUBEFORGE_SMTP_PASS=
# TUBEFORGE_SMTP_FROM=no-reply@example.com

# Stage 2 — server-wide YouTube OAuth client (preferred source; users only
# connect their own channel). Falls back to the claiming owner's migrated
# rows when unset. Leave unset for local dev.
# TUBEFORGE_YT_CLIENT_ID=
# TUBEFORGE_YT_CLIENT_SECRET=

# Stage 1 (T-1.8): when set, the first claim on a fresh install must present
# this token — an extra guard on top of the Stage 2 registration flow.
# Generate your own:  openssl rand -hex 24
# TUBEFORGE_OWNER_TOKEN=

# Stage 7.1 — Stripe billing. Leave unset for local dev. Since Stage
# 7.1 the webhook is FAIL-CLOSED: with the webhook secret unset the endpoint
# accepts NOTHING (401; 500 under NODE_ENV=production). Local development
# that exercises the webhook without signatures must opt in explicitly with
# TUBEFORGE_ALLOW_UNSIGNED_WEBHOOKS=1 — never set it in production. With the
# secret set, the `stripe-signature` header is REQUIRED and verified
# (HMAC + 300s replay window): a missing or invalid signature is a 401.
# TUBEFORGE_STRIPE_SECRET_KEY=
# TUBEFORGE_STRIPE_WEBHOOK_SECRET=
# TUBEFORGE_ALLOW_UNSIGNED_WEBHOOKS=

# S24 — the checkout + customer-portal doors. With the secret key set, the
# plan card (Settings) grows real buttons: "Upgrade to Creator/Studio"
# opens a Stripe-hosted Checkout session (mode=subscription), "Manage
# subscription" opens the Customer Portal. Checkout additionally needs ONE
# recurring Price id per tier you want to sell (create the Products +
# recurring Prices in the Stripe dashboard first). The card NEVER shows a
# price — the Stripe-hosted page (built from your Price objects) is the
# only place money is named. Without these, the routes fail closed (503)
# and the card shows an operator hint instead of dead buttons.
# TUBEFORGE_STRIPE_PRICE_CREATOR=
# TUBEFORGE_STRIPE_PRICE_STUDIO=

# CSRF trusted origins — comma-separated hostnames or full origins the cookie
# session is allowed to POST from. Without this the CSRF guard requires the
# browser's Origin to match the request Host header, which breaks deployments
# behind a reverse proxy that rewrites Host (preview environments, load
# balancers, edge CDNs). Set it to the public hostnames users see in their
# browser; leave unset for direct same-host setups. Example:
#   TUBEFORGE_ALLOWED_ORIGINS=app.example.com,localhost:3000
# TUBEFORGE_ALLOWED_ORIGINS=
#
# S38 — the Z.ai chat-bot preview deployment pattern `preview-*.space-z.ai`
# is ALWAYS trusted as a built-in default (Z.ai's own preview platform; the
# deployment cannot have TUBEFORGE_ALLOWED_ORIGINS provisioned out-of-band,
# and without an unconditional trust the preview's first POST dies at the
# CSRF door before the z SDK is ever reached). The pattern is regex-tight
# (literal `preview-` prefix + literal `.space-z.ai` suffix, anchored) so
# lookalikes can't ride it. Production deployments on other domains still
# need TUBEFORGE_ALLOWED_ORIGINS as above; the built-in default is additive.

# ── Storage root ──
# Where the local driver keeps per-video artifacts (scene art, voiceover
# WAVs, renders). The default resolves from the process CWD — which is NOT
# stable behind standalone output: `node .next/standalone/server.js` chdirs
# to .next/standalone at boot, so uploads would silently move there on every
# rebuild. Pin an absolute path on self-hosted / preview deployments:
#   TUBEFORGE_UPLOAD_ROOT=/home/tubeforge/uploads
# TUBEFORGE_UPLOAD_ROOT=

# ── Shared voice server (OPERATOR feature — self-hosted TubeForge) ──
# Run ONE Chatterbox voice server (voice-server/voice_server.py) next to the
# app and every user gets voice cloning + synthesis with ZERO per-user setup.
# Users who save their OWN self-hosted server URL under Settings → AI
# Providers always take precedence over this shared fallback.
#   TUBEFORGE_SHARED_VOICE_URL=http://127.0.0.1:8931
#   TUBEFORGE_SHARED_VOICE_KEY=<the --key the server was started with>
# Auto-spawn the local server on app boot (loopback URLs only; the app never
# waits for it — the model loads in the background, synthesis retries on 503):
#   TUBEFORGE_SPAWN_VOICE_SERVER=1
#   TUBEFORGE_VOICE_SERVER_DIR=/opt/tubeforge/voice-server
#   TUBEFORGE_VOICE_SERVER_MODEL=chatterbox-turbo
# Recommended when the shared server runs on a small CPU: Chatterbox (turbo)
# synthesizes ~5-10x slower than realtime, so long narrations legitimately
# exceed the default 180s TTS timeout:
#   TUBEFORGE_TIMEOUT_TTS=600000
# Torch threads for voice_server.py (Chatterbox synthesis). Set this to the
# number of PHYSICAL cores the voice server may use — the default (unset)
# lets torch pick, which can idle half the CPU. More threads = ~proportional
# synthesis speedup on CPU-only machines:
#   VOICE_THREADS=2

# ---------------------------------------------------------------------------
# S27 — the $5 door: operator USD metering for paid chat/vision dispatches
# ---------------------------------------------------------------------------
# Every chat/vision call to a PAID external provider (openai-compatible
# hosts, anthropic, gemini) reserves its worst-case USD estimate from the
# versioned price registry (spend.ts, PRICING_VERSION) BEFORE dispatch and
# settles after — at the provider's reported token usage when one arrives,
# else conservatively at the estimate. New dispatches are admitted only
# while  recorded + outstanding + estimate <= stop line.  Because every
# estimate provably covers the actual cost (inputs via chars/3, outputs
# clamped to 8192 tokens), recorded spend can never cross the stop line,
# and true provider spend — including a hold lost to a mid-call crash —
# stays under the $5.00 experiment ceiling. Z.ai-gateway and self-hosted
# (ollama/lmstudio/vllm) dispatches are metered but never gated or priced.
# Stop line, in USD (default 4.50 — the review's allocation leaves $0.50
# of headroom under the $5.00 ceiling):
#   TUBEFORGE_SPEND_STOP_USD=4.50
# Escape hatch: lift the gate (metering + pricing keep running; only the
# block is lifted):
#   TUBEFORGE_SPEND_GATE=0
