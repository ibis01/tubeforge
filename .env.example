# TubeForge environment template — copy to .env and fill in your own values.
# Your real .env is gitignored and will never be pushed.

# Database
# - Production / Vercel (default in prisma/schema.prisma):
#   DATABASE_URL=postgresql://user:password@host:5432/tubeforge
# - Local development with SQLite: switch the schema provider to "sqlite"
#   (see SETUP.md "Local development") and use:
DATABASE_URL=postgresql://user:password@host:5432/tubeforge

# Signs every session/API token (HMAC). Rotating it invalidates ALL issued
# tokens. Without it the production server refuses to serve any API (503).
# Generate your own:  openssl rand -hex 32
TUBEFORGE_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Stage 2 — encrypts secrets at rest (provider API keys, YouTube refresh
# tokens) with AES-256-GCM. Rotating it invalidates every STORED secret.
# Without it any credential save fails closed (visible error, no plaintext).
# Generate your own:  openssl rand -hex 32
TUBEFORGE_ENCRYPTION_KEY=replace-with-another-openssl-rand-hex-32

# Stage 3 (T-3.9) — email delivery mode for verification / password-reset links.
#   console (default) — links are logged + returned in the response (no SMTP;
#                       fine for single-owner installs and local dev)
#   smtp               — real delivery through the zero-dep SMTP client
#                       (STARTTLS on 25/587, implicit TLS on 465)
# TUBEFORGE_EMAIL_MODE=console
# TUBEFORGE_SMTP_HOST=smtp.example.com
# TUBEFORGE_SMTP_PORT=587
# TUBEFORGE_SMTP_USER=postmaster@example.com
# TUBEFORGE_SMTP_PASS=
# TUBEFORGE_SMTP_FROM=no-reply@example.com

# Stage 2 — server-wide YouTube OAuth client (preferred source; users only
# connect their own channel). Falls back to the claiming owner's migrated
# rows when unset. Leave unset for local dev.
# TUBEFORGE_YT_CLIENT_ID=
# TUBEFORGE_YT_CLIENT_SECRET=

# Stage 1 (T-1.8): when set, the first claim on a fresh install must present
# this token — an extra guard on top of the Stage 2 registration flow.
# Generate your own:  openssl rand -hex 24
# TUBEFORGE_OWNER_TOKEN=

# Stage 7 (T-7.5) — Stripe billing. Leave unset for local dev. Since Stage
# 7.1 the webhook is FAIL-CLOSED: with the webhook secret unset the endpoint
# accepts NOTHING (401; 500 under NODE_ENV=production). Local development
# that exercises the webhook without signatures must opt in explicitly with
# TUBEFORGE_ALLOW_UNSIGNED_WEBHOOKS=1 — never set it in production. With the
# secret set, the `stripe-signature` header is REQUIRED and verified
# (HMAC + 300s replay window): a missing or invalid signature is a 401.
# TUBEFORGE_STRIPE_SECRET_KEY=
# TUBEFORGE_STRIPE_WEBHOOK_SECRET=
# TUBEFORGE_ALLOW_UNSIGNED_WEBHOOKS=
