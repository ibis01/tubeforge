# TubeForge staging inputs (S110) — copy to .env.staging, fill in, never commit.
# The provisioner sources this file automatically (scripts/staging-provision.sh).
# Where each value comes from: docs/runbooks/staging.md §1.

# --- Database: a Neon BRANCH of the production project (resettable, free) ----
#   Neon dashboard → your project → Branches → Create branch → copy the
#   connection string (use the pooled endpoint for the app).
TUBEFORGE_STAGING_DB_URL="postgresql://…"

# --- Object storage: a SEPARATE R2 bucket ------------------------------------
#   R2 dashboard → Create bucket (e.g. tubeforge-staging) → Manage API tokens
#   → S3 API token with Object Read & Write on that bucket.
TUBEFORGE_STAGING_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
TUBEFORGE_STAGING_S3_BUCKET="tubeforge-staging"
TUBEFORGE_STAGING_S3_ACCESS_KEY_ID=""
TUBEFORGE_STAGING_S3_SECRET_ACCESS_KEY=""

# --- Stripe: TEST MODE ONLY ---------------------------------------------------
#   Stripe dashboard → toggle "Test mode" → Developers → API keys, and
#   Product catalog → the two test prices (creator / studio tiers).
TUBEFORGE_STAGING_STRIPE_SECRET_KEY="sk_test_…"
TUBEFORGE_STAGING_STRIPE_PRICE_CREATOR="price_…"
TUBEFORGE_STAGING_STRIPE_PRICE_STUDIO="price_…"
# Filled in AFTER the webhook endpoint is registered (runbook §3 step 1):
TUBEFORGE_STAGING_STRIPE_WEBHOOK_SECRET="whsec_…"

# --- Optional -----------------------------------------------------------------
# YouTube test OAuth client (runbook §4.5) — Google Cloud console, test users only.
TUBEFORGE_STAGING_YT_CLIENT_ID=""
TUBEFORGE_STAGING_YT_CLIENT_SECRET=""
# One Z.ai provider key for the pipeline drill (Settings → AI Providers also
# works — that is the documented path; this only seeds it at provision time).
TUBEFORGE_STAGING_ZAI_KEY=""
# Override the app name if you run more than one staging:
TUBEFORGE_STAGING_APP="tubeforge-staging"
