// GENERATED from schema.prisma by scripts/sync-sqlite-schema.mjs — DO NOT EDIT.
// Regenerate with: npm run db:sync-sqlite (also run by setup:local / postinstall).
// Provider swapped to SQLite for local development; every field definition is
// a verbatim copy of schema.prisma (the PostgreSQL deployment schema).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Stage 2 — multi-tenant identity. Every content model below carries
// organizationId and cascades from its Organization. The tenant guard lives in
// src/lib/tubeforge/tenant-db.ts (a Prisma client extension that injects
// organizationId into every query for these models from the request's tenant
// context) — raw db access in routes is forbidden by the ESLint rule
// tf/no-raw-db-in-api (deep libs may use it only outside request scopes).
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  // pbkdf2$<iters>$<saltB64>$<hashB64> — same format the single-user lock used
  // (src/lib/tubeforge/auth.ts), so a legacy auth.password row migrates as-is.
  passwordHash String
  name         String?
  avatarUrl    String?

  // Email verification / password recovery. Only the SHA-256 hash of the
  // token is stored; the raw token lives in the emailed link.
  emailVerifiedAt        DateTime?
  emailVerifyTokenHash   String?   @unique
  emailVerifyExpiresAt   DateTime?
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  settings            UserSetting[]
  youtubeAccounts     YouTubeAccount[]
  providerCredentials ProviderCredential[]
  sessions            Session[]
  activities          Activity[]
  jobs                Job[]
  usageRecords        UsageRecord[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  channels         Channel[]
  characters       Character[]
  videos           Video[]
  activities       Activity[]
  researchSessions ResearchSession[]
  slots            ScheduleSlot[]
  stats            VideoStat[]
  voiceProfiles    VoiceProfile[]
  musicTracks      MusicTrack[]
  jobs             Job[]
  storageUsage     StorageUsage?
  usageRecords     UsageRecord[]
  appearances      CharacterAppearance[]
}

// One user per organization row. Exactly one member holds role "owner" —
// enforced by a partial unique index (see prisma/migrations/…_stage2), which
// Prisma cannot express in the schema DSL.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String // owner | admin | editor | viewer
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Server-side sessions (7-day expiry, revocable). The cookie carries an HMAC
// token whose payload includes sid; requireUser() resolves the Session row to
// honor revocation — a stolen cookie dies the moment the row is revoked.
model Session {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  userAgent      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Per-user key/value store. Replaces the global Setting table (R-CRIT-2).
// Non-secret preferences only — secrets go to ProviderCredential /
// YouTubeAccount (encrypted at rest).
model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Per-user YouTube connection. Secrets (refresh/access tokens) are stored
// AES-256-GCM encrypted with TUBEFORGE_ENCRYPTION_KEY (src/lib/tubeforge/crypto.ts).
model YouTubeAccount {
  id             String    @id @default(cuid())
  userId         String
  channelId      String // the YouTube channel id (learned after consent)
  channelTitle   String?
  channelThumb   String?
  refreshToken   String // encrypted at rest
  accessToken    String? // encrypted at rest; ~50-min cache
  tokenExpiresAt DateTime?
  privacyStatus  String    @default("unlisted")
  categoryId     String    @default("27")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

// Per-user provider keys. Non-zai providers only — the bundled Z.ai SDK is a
// platform-level credential (see ARCHITECTURE.md §Stage 2 deviations).
model ProviderCredential {
  id         String   @id @default(cuid())
  userId     String
  capability String // chat | tts | image | video | asr | vision
  provider   String // openai | anthropic | gemini | zhipu | elevenlabs | stability | fal | replicate | ideogram | recraft | pollinations | selfhost
  baseUrl    String?
  apiKey     String // encrypted at rest
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability, provider])
}

// Legacy rows from the removed single-user Setting table, kept ONLY until the
// first owner claims them (POST /api/auth/register prove-the-old-password
// flow) — the claim migrates them into the owner's UserSetting /
// YouTubeAccount / ProviderCredential / User.passwordHash and deletes them.
// Dropped entirely in Stage 3.
// LegacySetting — REMOVED from the schema (Stage 3, T-3.11). The table is
// now UNMANAGED: Prisma neither creates nor drops it. Lifecycle:
//   * unclaimed legacy install: migrate-stage2.mjs RENAMEd Setting →
//     LegacySetting (raw SQL); the rows wait there for the owner's claim.
//   * claim (src/lib/tubeforge/claim.ts): every row migrates per-user, then
//     the table is DROPped — nothing legacy survives the transition.
//   * fresh installs: the table never exists; claim's raw reads tolerate that.

// ---------------------------------------------------------------------------
// Content models (tenant-scoped)
// ---------------------------------------------------------------------------

model Channel {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  niche          String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  videos         Video[]

  @@index([organizationId])
}

model Character {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  role            String?
  personality     String?
  appearance      String?
  identityAnchor  String?
  // Stage 5 (AI Director) — reference image library backing identity locking
  // and the VLM continuity check. JSON array of storage keys (T-3.7 driver
  // namespace, e.g. "characters/<id>/ref-1.png"), oldest first.
  referenceImages String?
  voice           String                @default("jam")
  artStyle        String                @default("cinematic")
  hasPortrait     Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  videos          Video[]
  appearances     CharacterAppearance[]

  @@index([organizationId])
}

model Video {
  id             String  @id @default(cuid())
  organizationId String
  title          String?
  topic          String
  niche          String
  tone           String  @default("informative")
  length         String  @default("medium")
  script         String?
  description    String?
  tags           String?
  status         String  @default("draft")
  voice          String  @default("jam")
  ttsSpeed       Float   @default(1.0)
  thumbStyle     String  @default("cinematic")

  // Bring-your-own-voice — "tts" = built-in AI voices, "custom" = user-provided
  // audio (uploaded file or downloaded from an internet URL)
  voiceSource String  @default("tts")
  voiceLabel  String? // display name of the custom voice (file name / URL)

  // Story engine (Phase 2) — "script" = classic narration, "story" = scene-based
  format        String  @default("script")
  renderMode    String  @default("kenburns")
  scenes        String? // JSON array of Scene {title, narration, visual, camera, mood, caption, hostInScene}
  hasStoryboard Boolean @default(false)
  hasVideo      Boolean @default(false)
  // Stage 3 (T-3.7): preview renders mark their own artifact — the DTO can
  // then report assets from DB flags on BOTH storage drivers (an fs
  // existsSync probe would silently lie under s3).
  hasPreview    Boolean @default(false)
  videoDuration Float?

  hasVoiceover  Boolean    @default(false)
  hasThumbnail  Boolean    @default(false)
  audioDuration Float?
  wordCount     Int?
  error         String?
  channelId     String?
  channel       Channel?   @relation(fields: [channelId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  verifyReport  String? // JSON ASR narration-check report (Phase 3)
  commentsKit   String? // JSON engagement kit: pinned comment + replies + strategy (Phase 4)
  youtubeUrl    String? // https://youtu.be/<id> after a successful OAuth upload (Phase 4)
  publishedAt   DateTime? // real publish date reported by YouTube (Phase 5 analytics)

  // Auto-Short (Phase 5) — 9:16 vertical cut rendered from the final video
  hasShort      Boolean @default(false)
  shortScene    Int? // scene index the short was cut from (null = auto-picked)
  shortDuration Float?  @default(0)

  // Background music (per-video overrides; null = fall back to Settings defaults)
  musicEnabled          Boolean? // null = use the global default (Settings -> Background Music)
  musicTrackId          String? // manual pick (overrides auto mood-matching)
  musicVolume           Float? // 0..1 multiplier applied to the licensed track
  musicFadeIn           Float? // seconds
  musicFadeOut          Float? // seconds
  musicDucking          Boolean? // null = Settings default; false = constant bed under the voice
  musicDuckingIntensity String? // subtle | standard | strong (audiomix.ts catalog)
  musicMood             String? // auto | suspenseful | cinematic | emotional | uplifting | calm

  // Smart Motion (Ken Burns) per-video overrides; null = built-in defaults
  // (smart scene-aware mode, 12% zoom intensity, smooth easing, direction
  // variation on — see src/lib/tubeforge/motion.ts)
  motionMode      String? // smart | zoom | pan | off
  motionIntensity Int? // 0..30 (% zoom amplitude)
  motionCurve     String? // smooth | linear
  motionVary      Boolean?

  // Scene transitions (per-video overrides; null = built-in default fade).
  // style ids live in src/lib/tubeforge/transitions.ts (fade, fadeblack, …,
  // "cut" = hard cuts); duration is the blend length in seconds.
  transitionStyle    String? // fade | cut | … (transitions.ts catalog)
  transitionDuration Float? // blend length, 0.2..1.5 s

  // Brand kit (keynote slides) — accent recolors every slide's highlight
  // system (null = the built-in per-slide catalog accents); brandLogoOn
  // toggles the corner logo badge on every slide (null = on when a logo
  // exists). The logo file itself lives at uploads/<videoId>/brand-logo.*.
  brandAccent String? // #rrggbb, null = catalog accents
  brandLogoOn Boolean? // null = show badge whenever a logo is uploaded

  // Post-render quality gate — JSON report from qc.ts: streams, duration,
  // loudness, peaks, black frames, SRT sanity.
  qcReport String?

  // Stage 5 — AI Director. shotList is the JSON DirectorPlan (per-scene shot
  // list: framing / camera / lens / composition / durations / transition-in /
  // motion hint + per-scene visual mood) produced by the LLM director pass.
  // directorState: null (never run) | "proposed" (awaiting human approval) |
  // "approved" (plan steers image prompts, motion + transitions) | "dismissed".
  // consistency is the JSON ContinuityReport from the VLM per-scene check.
  shotList      String?
  directorState String?
  consistency   String?
  appearances   CharacterAppearance[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   Activity[]
  slots        ScheduleSlot[]
  stats        VideoStat[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  userId         String? // null = legacy row created before Stage 2
  videoId        String?
  video          Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage          String
  message        String
  level          String       @default("info")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model ResearchSession {
  id             String       @id @default(cuid())
  organizationId String
  niche          String
  query          String
  ideas          String // JSON-serialized array of ResearchIdeaDTO
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model ScheduleSlot {
  id             String       @id @default(cuid())
  organizationId String
  videoId        String?
  video          Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channelId      String?
  title          String
  slotDate       DateTime // publish day (midnight, local calendar day)
  timeOfDay      String       @default("18:00")
  note           String?
  done           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([slotDate])
}

// Phase 5 — performance snapshots pulled from the YouTube Data API for
// published videos. One row per (video, sync) so the analytics view can chart
// growth deltas between syncs and the Topic Radar can learn from winners.
model VideoStat {
  id             String       @id @default(cuid())
  organizationId String
  videoId        String
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  views          Int          @default(0)
  likes          Int          @default(0)
  comments       Int          @default(0)
  favorites      Int          @default(0)
  snapshotAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([videoId, snapshotAt])
}

// Voice cloning — a speaker's voice recreated from a short (3-30s) sample.
// provider "zhipu": recreated via the Zhipu GLM-TTS-Clone API —
// providerVoiceId (voice_clone_…) is what the TTS call sends in its `voice`
// field; it only speaks on the SAME platform account that created it.
// provider "selfhost": the normalized sample itself is stored (sampleWav,
// base64) and re-sent to the user's voice_server.py (Chatterbox) on every
// synthesis — the "clone" lives on the user's own machine.
// auditionWav caches the clone-time preview audio (base64) so the UI can
// replay "how the clone sounds" without a fresh TTS call.
model VoiceProfile {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  provider        String       @default("zhipu") // platform that holds the cloned voice
  providerVoiceId String // voice_clone_20240315_143052_001
  sourceLabel     String? // original sample file name / URL label
  durationSec     Float? // length of the source sample
  auditionWav     String? // base64 WAV returned by the clone call (short preview)
  sampleWav       String? // base64 normalized sample — self-hosted clones re-send it per synthesis
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
  @@index([provider])
}

// Background-music library — every track carries its license record so a
// published video can always answer "is this safe to monetize?". The
// TubeForge-original beds are synthesized in-app (zero third-party samples);
// users can upload their OWN licensed tracks with full attribution metadata.
model MusicTrack {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  // Comma-separated mood/niche tags used by the auto-selection engine, e.g.
  // "motivation,uplifting" — niches map onto these tags (see music.ts).
  moods          String  @default("")
  genre          String?
  durationSec    Float   @default(0)
  filePath       String // relative path under uploads/, e.g. "_music/uplifting-aurora.wav"
  fileSizeBytes  Int     @default(0)
  isOriginal     Boolean @default(false) // synthesized by TubeForge — no third-party audio

  // --- Copyright / license record (kept for every track, shown in UI) ---
  licenseType         String   @default("TubeForge Original") // e.g. "YouTube Audio Library", "CC BY 4.0", "Commercial license"
  sourceUrl           String?
  commercialUse       Boolean  @default(true)
  attributionRequired Boolean  @default(false)
  attributionText     String? // exact credit line to paste into the description
  licenseEvidence     String? // URL or note proving the license (screenshot, license page)
  downloadedAt        DateTime @default(now())
  contentIdNotes      String? // known Content ID claims / restrictions, if any

  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive])
}

// Stage 5 (AI Director) — per-scene clothing / accessory / mood tracking for
// the recurring cast, written by the director pass and read back by image
// generation ("same outfit as scene 3") and the VLM continuity check.
// Unique on (videoId, sceneIndex, characterId): one look per character per scene.
model CharacterAppearance {
  id             String       @id @default(cuid())
  organizationId String
  characterId    String
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  videoId        String
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sceneIndex     Int
  outfit         String?
  accessory      String?
  mood           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([videoId, sceneIndex, characterId])
  @@index([organizationId])
  @@index([characterId])
}

// Phase 3 — persistent job registry: survives server restarts so interrupted
// stages can be detected ("running" rows from a dead process) and surfaced
// to users instead of silently vanishing like the old in-memory maps.
model Job {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String? // who kicked the job (null = legacy row)
  kind            String // voiceover | thumbnail | variants | portrait | poses | storyboard | render | scene | verify | …
  entityId        String // video id, character id, or "<videoId>#scene<N>"
  status          String       @default("pending") // pending | running | done | failed | interrupted | cancelled
  progress        Float? // 0..1
  label           String? // human progress label ("Rendering scene 3 of 6")
  error           String?
  attempts        Int          @default(0) // claim cycles started (Stage 3 queue)
  maxAttempts     Int          @default(2) // claim cycles allowed before "failed" sticks
  nextRunAt       DateTime     @default(now()) // earliest claim time (retry backoff)
  claimedBy       String? // "<role>:<pid>:<bootTs>" of the executing process
  claimedAt       DateTime?
  // Stage 3 close-out — JSON-encoded request options (render mode, scene
  // instruction, voiceover source pointer, …). Write-once at enqueue, parsed
  // by the kind's crash-recovery handler so a restarted process can re-run
  // the job with the SAME choices instead of factory defaults. Kept as TEXT
  // (not a Json column) so the SQLite mirror and Postgres behave identically.
  payload         String?
  cancelRequested Boolean      @default(false) // cooperative cancel — visible cross-process
  startedAt       DateTime     @default(now()) // set at claim (execution start)
  endedAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityId, kind])
  @@index([status])
  @@index([startedAt])
  @@index([status, nextRunAt]) // Stage 3 queue claim scan
}

// Stage 3 (T-3.7) — per-organization storage byte counter backing storage.ts
// quotas. A counter, not a listing: O(1) quota checks on every put. Rebuild
// from the driver with `npm run storage:recompute` if it ever drifts.
model StorageUsage {
  organizationId String       @id
  bytes          BigInt       @default(0)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Stage 3 (T-3.8) — per-user, per-capability AI cost tracking. Written by the
// provider layer on every metered call; surfaced via GET /api/account/usage.
// costMicroUsd keeps exact integers (no float drift); tokens follow provider
// reports where available, else 0.
model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  capability     String // chat | tts | image | video | asr | youtube | generic
  provider       String // zai | openai | elevenlabs | ... ("internal" = local work)
  model          String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costMicroUsd   Int      @default(0) // micro-dollars (1e-6 USD)
  latencyMs      Int?
  ok             Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, capability, createdAt])
}
