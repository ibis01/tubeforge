generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  niche       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]
}

model Character {
  id             String   @id @default(cuid())
  name           String
  role           String?
  personality    String?
  appearance     String?
  identityAnchor String?
  voice          String   @default("jam")
  artStyle       String   @default("cinematic")
  hasPortrait    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  videos         Video[]
}

model Video {
  id            String    @id @default(cuid())
  title         String?
  topic         String
  niche         String
  tone          String    @default("informative")
  length        String    @default("medium")
  script        String?
  description   String?
  tags          String?
  status        String    @default("draft")
  voice         String    @default("jam")
  ttsSpeed      Float     @default(1.0)
  thumbStyle    String    @default("cinematic")

  // Story engine (Phase 2) — "script" = classic narration, "story" = scene-based
  format        String    @default("script")
  renderMode    String    @default("kenburns")
  scenes        String?   // JSON array of Scene {title, narration, visual, camera, mood, caption, hostInScene}
  hasStoryboard Boolean   @default(false)
  hasVideo      Boolean   @default(false)
  videoDuration Float?

  hasVoiceover  Boolean   @default(false)
  hasThumbnail  Boolean   @default(false)
  audioDuration Float?
  wordCount     Int?
  error         String?
  channelId     String?
  channel       Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activities    Activity[]
  slots         ScheduleSlot[]

  @@index([status])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage     String
  message   String
  level     String   @default("info")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ResearchSession {
  id        String   @id @default(cuid())
  niche     String
  query     String
  ideas     String // JSON-serialized array of ResearchIdeaDTO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ScheduleSlot {
  id        String   @id @default(cuid())
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channelId String?
  title     String
  slotDate  DateTime // publish day (midnight, local calendar day)
  timeOfDay String   @default("18:00")
  note      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotDate])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
