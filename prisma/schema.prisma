generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  niche       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videos      Video[]
}

model Character {
  id             String   @id @default(cuid())
  name           String
  role           String?
  personality    String?
  appearance     String?
  identityAnchor String?
  voice          String   @default("jam")
  artStyle       String   @default("cinematic")
  hasPortrait    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  videos         Video[]
}

model Video {
  id            String    @id @default(cuid())
  title         String?
  topic         String
  niche         String
  tone          String    @default("informative")
  length        String    @default("medium")
  script        String?
  description   String?
  tags          String?
  status        String    @default("draft")
  voice         String    @default("jam")
  ttsSpeed      Float     @default(1.0)
  thumbStyle    String    @default("cinematic")

  // Bring-your-own-voice — "tts" = built-in AI voices, "custom" = user-provided
  // audio (uploaded file or downloaded from an internet URL)
  voiceSource   String    @default("tts")
  voiceLabel    String? // display name of the custom voice (file name / URL)

  // Story engine (Phase 2) — "script" = classic narration, "story" = scene-based
  format        String    @default("script")
  renderMode    String    @default("kenburns")
  scenes        String?   // JSON array of Scene {title, narration, visual, camera, mood, caption, hostInScene}
  hasStoryboard Boolean   @default(false)
  hasVideo      Boolean   @default(false)
  videoDuration Float?

  hasVoiceover  Boolean   @default(false)
  hasThumbnail  Boolean   @default(false)
  audioDuration Float?
  wordCount     Int?
  error         String?
  channelId     String?
  channel       Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  verifyReport String? // JSON ASR narration-check report (Phase 3)
  commentsKit  String? // JSON engagement kit: pinned comment + replies + strategy (Phase 4)
  youtubeUrl   String? // https://youtu.be/<id> after a successful OAuth upload (Phase 4)
  publishedAt  DateTime? // real publish date reported by YouTube (Phase 5 analytics)

  // Auto-Short (Phase 5) — 9:16 vertical cut rendered from the final video
  hasShort     Boolean  @default(false)
  shortScene   Int? // scene index the short was cut from (null = auto-picked)
  shortDuration Float? @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activities    Activity[]
  slots         ScheduleSlot[]
  stats         VideoStat[]

  @@index([status])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stage     String
  message   String
  level     String   @default("info")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ResearchSession {
  id        String   @id @default(cuid())
  niche     String
  query     String
  ideas     String // JSON-serialized array of ResearchIdeaDTO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ScheduleSlot {
  id        String   @id @default(cuid())
  videoId   String?
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channelId String?
  title     String
  slotDate  DateTime // publish day (midnight, local calendar day)
  timeOfDay String   @default("18:00")
  note      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slotDate])
}

// Phase 5 — performance snapshots pulled from the YouTube Data API for
// published videos. One row per (video, sync) so the analytics view can chart
// growth deltas between syncs and the Topic Radar can learn from winners.
model VideoStat {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  favorites Int      @default(0)
  snapshotAt DateTime @default(now())

  @@index([videoId, snapshotAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Phase 3 — persistent job registry: survives server restarts so interrupted
// stages can be detected ("running" rows from a dead process) and surfaced
// to users instead of silently vanishing like the old in-memory maps.
model Job {
  id        String    @id @default(cuid())
  kind      String // voiceover | thumbnail | variants | portrait | poses | storyboard | render | scene | verify
  entityId  String // video id, character id, or "<videoId>#scene<N>"
  status    String    @default("running") // running | done | failed | interrupted
  progress  Float? // 0..1
  label     String? // human progress label ("Rendering scene 3 of 6")
  error     String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([entityId, kind])
  @@index([status])
  @@index([startedAt])
}
