{
  "name": "tubeforge",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "dev:daemon": "python3 scripts/daemonize.py scripts/next-daemon.log npm exec -- next dev -p 3000 -H 0.0.0.0",
    "build": "rm -rf .next/standalone && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "setup": "node scripts/postinstall.mjs",
    "setup:local": "node scripts/sync-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma && node scripts/migrate-stage2.mjs",
    "backup": "bash scripts/backup.sh",
    "db:backup:pg": "bash scripts/backup-postgres.sh",
    "migrate:stage2": "node scripts/migrate-stage2.mjs",
    "db:sync-sqlite": "node scripts/sync-sqlite-schema.mjs",
    "auth:reset": "node scripts/auth-reset.mjs",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "node --import tsx scripts/test-unit.mts",
    "test:queue": "node --import tsx scripts/test-queue.mts",
    "test:coverage": "node scripts/test-coverage.mjs",
    "worker": "node --import tsx scripts/worker.mts",
    "worker:daemon": "python3 scripts/daemonize.py scripts/worker-daemon.log npm run worker",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:billing && npm run test:storage && npm run test:rate && npm run test:scene-revisions && npm run test:drill && npm run alert:probe",
    "test:e2e": "playwright test",
    "test:billing": "node --import tsx scripts/test-billing.mts",
    "test:storage": "node --import tsx scripts/test-storage.mts",
    "test:rate": "node --import tsx scripts/test-rate-limit.mts",
    "test:scene-revisions": "node --import tsx scripts/test-scene-revisions.mts",
    "test:drill": "node --import tsx scripts/restore-drill.mts",
    "smoke:docker": "bash scripts/docker-smoke.sh",
    "alert:probe": "node --import tsx scripts/alert-probe.mts",
    "verify:clone": "node --import tsx scripts/test-clean-clone.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@reactuses/core": "^6.6.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "heic-convert": "^2.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next": "^16.4.5",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "playwright": "1.65.0",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0",
    "undici": "^8.12.4",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "c8": "^12.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "deepmerge-ts": "8.0.0",
    "minimatch": "^11.0.1"
  }
}
