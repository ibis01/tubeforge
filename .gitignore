# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log

server.log
# Skills directory
/skills/
# Runtime data — NEVER commit or distribute (contains credentials + private records)
/db/*
!/db/.gitkeep
/uploads/*
!/uploads/.gitkeep
/pack/
/download/
/tool-results/
/backups/
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- tf-git-setup: repo hygiene ---
# keep the env template (the .env* rule above still hides the real .env)
!.env.example
# local-only workspace dirs
/upload/
/forensics/
# packaging artifacts
public/tubeforge-local.zip
public/tubeforge/
*.tar

# editor / OS
.vscode/
.idea/
Thumbs.db

# runtime pid file (server state, not source)
.zscripts/dev.pid

# local screenshot scratch
/.zshots/
/.zanalysis/
